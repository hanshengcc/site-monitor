# Database connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://monitor:monitor123@localhost:5432/site_monitor
DATABASE_URL_SYNC=postgresql://monitor:monitor123@localhost:5432/site_monitor

# Screenshots storage directory
SCREENSHOTS_DIR=./screenshots

# Intervals and concurrency
CHECK_INTERVAL_MINUTES=5
SCREENSHOT_INTERVAL_MINUTES=360
PLAYWRIGHT_CONCURRENCY=8
MAX_CONCURRENT_CHECKS=200
CHECK_TIMEOUT=15
SCREENSHOT_TIMEOUT=30
